{
  "name": "telepatia-cli",
  "version": "0.1.0",
  "description": "CLI no oficial y de código abierto para Telepatia Scribe: consultas, notas, transcripciones, pacientes y plantillas desde la terminal.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "telepatia": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/note.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "telepatia",
    "scribe",
    "cli",
    "medical",
    "transcription"
  ],
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^12.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ehoyos-create/telepatia-cli.git"
  },
  "homepage": "https://github.com/ehoyos-create/telepatia-cli#readme",
  "bugs": {
    "url": "https://github.com/ehoyos-create/telepatia-cli/issues"
  }
}
